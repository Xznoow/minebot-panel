# Copie ce fichier en .env puis remplis les valeurs (le fichier .env n'est jamais envoyé sur Git)

# Adresse du serveur Minecraft
MC_HOST=localhost
# Port du serveur (facultatif : laisse vide pour une adresse résolue par DNS, ex. Aternos)
MC_PORT=
# Pseudo du bot (le serveur doit être en offline-mode / « cracké »)
MC_USERNAME=Bot1

# Port du panel web (accessible uniquement depuis ta machine)
PANEL_PORT=3000
